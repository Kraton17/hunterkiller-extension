{
  "manifest_version": 3,
  "name": "HunterKiller",
  "version": "2.0.1",
  "description": "Elite email discovery browser extension. Free Hunter.io alternative. Extract contacts from any domain.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "HunterKiller"
  },
  "background": {
    "scripts": ["js/background.js"]
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hunterkiller@youremail.com"
    }
  }
}
